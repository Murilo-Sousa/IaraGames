# Copie este arquivo para server/.env e preencha os valores.

# Chave secreta da Stripe em MODO DE TESTE (painel da Stripe > Desenvolvedores > Chaves de API).
# Ela comeca com sk_test_ e nunca deve ir para o navegador nem para o GitHub.
STRIPE_SECRET_KEY=

# Endereco do site. Ele e usado nas paginas de retorno do pagamento.
# Em casa, deixe http://localhost:3000.
BASE_URL=http://localhost:3000

# Porta do servidor (opcional).
PORT=3000
